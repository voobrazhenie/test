# Instagram MCP — configuration
#
# Only INSTAGRAM_ACCESS_TOKEN is strictly required to run the server.
# The other values are needed by `npm run auth`, which mints and refreshes
# that token for you and caches it in ~/.config/instagram-mcp/token.json.

# Long-lived access token (60 days, refreshable).
# Leave unset if you used `npm run auth` — the server reads the cached token.
INSTAGRAM_ACCESS_TOKEN=

# From your Meta app dashboard.
#   Instagram Login  -> App Dashboard > Instagram > API setup with Instagram login
#   Facebook Login   -> App Dashboard > Settings > Basic
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must exactly match a redirect URI registered on the app. HTTPS only.
INSTAGRAM_REDIRECT_URI=https://localhost/auth/callback

# "instagram_login" (default) talks to graph.instagram.com and works with an
# Instagram Business/Creator account on its own.
# "facebook_login" talks to graph.facebook.com and requires the Instagram
# account to be linked to a Facebook Page.
INSTAGRAM_AUTH_MODE=instagram_login

# Only for facebook_login mode, and only if auto-discovery picks the wrong
# account. The numeric Instagram Business account id.
INSTAGRAM_USER_ID=

# Optional overrides.
# INSTAGRAM_GRAPH_VERSION=v23.0
# INSTAGRAM_TOKEN_FILE=/custom/path/token.json
