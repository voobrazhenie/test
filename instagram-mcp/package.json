{
  "name": "instagram-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for reading like counts and engagement on your own Instagram posts",
  "type": "module",
  "bin": {
    "instagram-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth.ts",
    "test": "node --import tsx --test src/stats.test.ts src/instagram.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.10"
  }
}
